    {
      "name": "delay_by_airline",
      "displayName": "Delay Categories by Airline",
      "queryLines": [
        "SELECT\n",
        "  airline_name,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN delay_minutes <= 0 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS on_time,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN delay_minutes BETWEEN 1 AND 30 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS minor_delay,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN delay_minutes BETWEEN 31 AND 60 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS moderate_delay,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN delay_minutes > 60 THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS severe_delay\n",
        "FROM\n",
        "  xe_training_catalog.databricks.flights_genie\n",
        "GROUP BY\n",
        "  airline_name\n",
        "ORDER BY\n",
        "  airline_name"
      ]
    },
    {
      "name": "revenue_over_time",
      "displayName": "Revenue Over Time",
      "queryLines": [
        "SELECT\n",
        "  flight_date,\n",
        "  SUM(revenue_usd) AS daily_revenue,\n",
        "  SUM(SUM(revenue_usd)) OVER (ORDER BY flight_date ROWS UNBOUNDED PRECEDING) AS cumulative_revenue,\n",
        "  COUNT(*) AS flights\n",
        "FROM\n",
        "  xe_training_catalog.databricks.flights_genie\n",
        "GROUP BY\n",
        "  flight_date\n",
        "ORDER BY\n",
        "  flight_date"
      ]
    }
  ],
